PDFSUM_MONGODB_URI=mongodb://usuario:contrasena@mongodb.example:27017/
PDFSUM_SERVER_URL=http://servidor-pdfsum:8766

PDFSUM_INPUT_MODE=url # Valores admitidos: url o folder
PDFSUM_INPUT_FOLDER= # Obligatorio solamente cuando PDFSUM_INPUT_MODE=folder; vacío cuando se usa url

# El URI se mantiene únicamente en el entorno; no versionar .env.
PDFSUM_SOURCE_DATABASE=FIs_02_converted
PDFSUM_SOURCE_COLLECTION=mis
PDFSUM_JOBS_DATABASE=Enrichment_IA
PDFSUM_JOBS_COLLECTION=document_extraction_jobs
PDFSUM_RESULTS_DATABASE=Enrichment_IA
PDFSUM_RESULTS_COLLECTION=document_abstracts
PDFSUM_RESULT_ID_PREFIX=mis-
PDFSUM_RESULT_FORMAT=bireme
